# 每日资讯本地生成环境变量示例
# 用法：cp task/news/.env.example task/news/.env.local，然后按需修改。

# 目标日期；留空时使用本机当天日期（YYYY-MM-DD）。
NEWS_DATE=

# 运行模式：
# - 1：只生成/保存将交给 Hermes 的 prompt，不调用模型（推荐先跑一次验证环境）。
# - 0：调用 hermes chat 按 prompt 生成/更新日报文件。
NEWS_DRY_RUN=1

# 是否允许生成任务提交并推送到 origin/main。
# 本地调试建议 0；正式定时任务可设为 1。
NEWS_COMMIT_PUSH=0

# 是否要求生成后运行 pnpm build。正式定时任务建议 1；本地快速调试可设为 0。
NEWS_RUN_BUILD=1

# 是否额外要求 pnpm test:doc-links / pnpm types:check。
NEWS_RUN_DOC_LINKS=0
NEWS_RUN_TYPES_CHECK=0

# Hermes CLI 命令与可选模型覆盖。
HERMES_CMD=hermes
HERMES_PROVIDER=
HERMES_MODEL=

# 输出 prompt 与来源提示的临时目录。
NEWS_TMP_DIR=task/news/tmp

# 可选：如果已有人工或其它工具生成的 MDX 草稿，用 apply-daily-news.mjs 写入正式路径。
# NEWS_INPUT_FILE=task/news/tmp/2026-08-20.mdx
NEWS_INPUT_FILE=
