# 每日资讯本地生成环境变量示例
# 用法：cp task/daily-news/.env.example task/daily-news/.env.local

# 目标日期；留空时使用本机当天日期（YYYY-MM-DD）。
DAILY_DATE=

# 运行模式：1 只生成 prompt；0 调用 Hermes。
DAILY_DRY_RUN=1

# 是否允许生成任务提交并推送到 origin/main。
DAILY_COMMIT_PUSH=0

# 是否在 cron 本地跑 build / summaries（正式定时建议均为 0，交给 Vercel）。
DAILY_RUN_BUILD=0
DAILY_RUN_SUMMARIES=0

# 是否额外要求 pnpm test:doc-links / pnpm types:check（push 后 CI 会跑）。
DAILY_RUN_DOC_LINKS=0
DAILY_RUN_TYPES_CHECK=0

# 覆盖已存在目标文件
DAILY_FORCE=0

# Hermes CLI 命令与可选模型覆盖。
HERMES_CMD=hermes
HERMES_PROVIDER=
HERMES_MODEL=

# 输出 prompt 与来源提示的临时目录。
DAILY_TMP_DIR=task/daily-news/tmp

# 兼容旧变量名（可选）
# NEWS_DATE=
# NEWS_DRY_RUN=
# NEWS_COMMIT_PUSH=

# 已有 MDX 草稿时用于 apply：
# DAILY_INPUT_FILE=task/daily-news/tmp/2026-08-20.mdx
