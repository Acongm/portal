{
  "name": "portal",
  "version": "0.0.1",
  "private": true,
  "description": "acongm portal — Next.js + Fumadocs documentation site",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "types:check": "pnpm --filter web types:check",
    "migrate:docs": "node scripts/migrate-docs.mjs",
    "sync:modules": "node scripts/sync-doc-modules.mjs",
    "sync:module-intros": "node scripts/sync-module-index-intro.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
