{
  "name": "portal",
  "version": "0.0.1",
  "private": true,
  "description": "acongm portal — Next.js + Fumadocs documentation site",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "types:check": "pnpm -r --filter @acongm/* --filter web types:check",
    "ui:list": "pnpm dlx shadcn@latest list Acongm/shadcn-ui",
    "ui:view": "pnpm dlx shadcn@latest view Acongm/shadcn-ui/core-ui",
    "ui:add": "pnpm -C apps/web dlx shadcn@latest add Acongm/shadcn-ui/core-ui",
    "test:ai-path": "node scripts/test-ai-chat-path.mjs",
    "test:doc-links": "node scripts/test-doc-links.mjs",
    "fix:doc-links": "node scripts/fix-doc-internal-links.mjs",
    "migrate:docs": "node scripts/migrate-docs.mjs",
    "sync:modules": "node scripts/sync-doc-modules.mjs",
    "sync:module-intros": "node scripts/sync-module-index-intro.mjs",
    "migrate:domains": "node scripts/migrate-to-domains.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
