{
  "name": "portal",
  "version": "0.0.1",
  "private": true,
  "description": "acongm portal — Next.js + Fumadocs documentation site",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "types:check": "pnpm -r --filter @acongm/* --filter web types:check",
    "ui:list": "node scripts/ui-registry.mjs list",
    "ui:view": "node scripts/ui-registry.mjs view core-ui",
    "ui:add": "node scripts/ui-registry.mjs add core-ui",
    "ui:sync": "node scripts/ui-registry.mjs sync core-ui",
    "ui:diff": "node scripts/ui-registry.mjs diff core-ui",
    "ui:drift": "node scripts/check-ui-drift.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:portal-chat-v2": "node --test tests/contracts/portal-chat-v2.test.mjs",
    "test:ai-path": "node scripts/test-ai-chat-path.mjs",
    "test:doc-links": "node scripts/test-doc-links.mjs",
    "fix:doc-links": "node scripts/fix-doc-internal-links.mjs",
    "migrate:docs": "node scripts/migrate-docs.mjs",
    "sync:modules": "node scripts/sync-doc-modules.mjs",
    "sync:module-intros": "node scripts/sync-module-index-intro.mjs",
    "migrate:domains": "node scripts/migrate-to-domains.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "sharp"] }
}
